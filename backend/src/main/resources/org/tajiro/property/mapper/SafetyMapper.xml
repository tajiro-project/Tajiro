<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.tajiro.property.mapper.SafetyMapper">

    <!-- 세부 시설 (CCTV 위치 및 폴리곤 정보) 매핑 -->
    <resultMap id="SafetyDetailMap" type="SafetyDetailDTO">
        <id property="safeDetailId" column="detail_id"/>
        <result property="safeName" column="detail_safe_name"/>
        <result property="latitude" column="detail_latitude"/>
        <result property="longitude" column="detail_longitude"/>
        <result property="distanceM" column="detail_distance_m"/>
        <result property="polygon" column="detail_polygon"/>
    </resultMap>

    <!-- 안전 카테고리 매핑 -->
    <resultMap id="SafetyItemMap" type="SafetyItemDTO">
        <id property="safeId" column="safe_id"/>
        <result property="safeCategory" column="safe_category"/>
        <result property="countWithin500m" column="count_within500m"/>
        <result property="nearestDistanceMeters" column="nearest_distance_meters"/>
        <result property="nearestSafeName" column="nearest_safe_name"/>
        <collection property="details" resultMap="SafetyDetailMap" notNullColumn="detail_id"/>
    </resultMap>

    <!-- 최상위 매물 및 건물 위치 매핑 -->
    <resultMap id="PropertySafetyResultMap" type="PropertySafetyDTO">
        <id property="propertyId" column="property_id"/>
        <result property="latitude" column="building_latitude"/>
        <result property="longitude" column="building_longitude"/>
        <collection property="safetyList" resultMap="SafetyItemMap" notNullColumn="safe_id"/>
    </resultMap>

    <!-- 매물 존재 여부 검증 -->
    <select id="existsPropertyById" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM property
            WHERE id = #{propertyId}
        )
    </select>

    <!-- 매물 안전 정보 전체 조회 -->
    <select id="selectPropertySafetyInfo" resultMap="PropertySafetyResultMap">
        SELECT
            p.id AS property_id,
            b.latitude AS building_latitude,
            b.longitude AS building_longitude,
            s.id AS safe_id,
            s.safe_category AS safe_category,
            s.count_within500m AS count_within500m,
            s.nearest_distance_meters AS nearest_distance_meters,
            (
                SELECT sd_near.safe_name
                FROM safety_detail sd_near
                WHERE sd_near.safe_id = s.id
                ORDER BY sd_near.sort_order ASC
                LIMIT 1
            ) AS nearest_safe_name,
            sd.id AS detail_id,
            sd.safe_name AS detail_safe_name,
            sd.latitude AS detail_latitude,
            sd.longitude AS detail_longitude,
            sd.distance_m AS detail_distance_m,
            sd.polygon AS detail_polygon
        FROM property p
                 INNER JOIN building b ON p.building_id = b.id
                 LEFT JOIN safety s ON b.id = s.building_id
                 LEFT JOIN safety_detail sd ON s.id = sd.safe_id
        WHERE p.id = #{propertyId}
        ORDER BY s.id ASC, sd.sort_order ASC
    </select>

</mapper>