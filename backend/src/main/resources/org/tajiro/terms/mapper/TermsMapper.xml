<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.tajiro.terms.mapper.TermsMapper">

    <!-- 1. 현재 유효한 약관 목록 조회 -->
    <select id="findEffectiveTerms" resultType="TermsVO">
        SELECT
            id,
            type,
            title,
            content,
            version,
            required,
            effective_at AS effectiveAt
        FROM terms
        WHERE effective_at &lt;= NOW()
        ORDER BY id
    </select>

    <!-- 2. 약관 상세 조회 -->
    <select id="findById" parameterType="long" resultType="TermsVO">
        SELECT
            id,
            type,
            title,
            content,
            version,
            required,
            effective_at AS effectiveAt
        FROM terms
        WHERE id = #{termsId}
    </select>

</mapper>
